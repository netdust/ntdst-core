{
    "name": "netdust/ntdst-core",
    "description": "NTDST Core Framework — DI container, Bootstrap, Router, Data layer, admin form layer for WordPress. Minimal layer: solid, secure code; features enter only with a named consumer.",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "authors": [{"name": "Stefan Vandermeulen", "email": "stefan@netdust.be"}],
    "require": {"php": ">=8.1"},
    "require-dev": {"phpunit/phpunit": "^10.5", "brain/monkey": "^2.6"},
    "autoload-dev": {"classmap": ["core/", "api/", "admin/", "services/"]},
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "gate": ["@lint", "@test"]
    }
}
